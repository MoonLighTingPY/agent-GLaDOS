# Copy to .env and fill in values
GROG_CLOUD_API_KEY=your_groq_key_here
GROG_API_URL=https://api.groq.com/openai/v1/chat/completions
GROG_MODEL=llama-3.1-8b-instant
WHISPER_MODEL=tiny

# TTS Configuration (Human-like voice)
TTS_VOICE_GENDER=female
TTS_STYLE=friendly
AUTO_PLAY_TTS=true
ENABLE_INTERRUPTION=true

# Wake Word Detection
USE_SIMPLE_WAKE_WORD=true
WAKE_WORDS=hey glados,гей глендос,слухай,listen

# Optional: Picovoice Porcupine (more accurate)
# PICOVOICE_ACCESS_KEY=your_picovoice_access_key
# WAKEWORD_KEYWORD_PATH=keyword.ppn

# Optional: Piper voices (auto-detected if placed in models/)
# PIPER_EN_VOICE=models/en_US-amy-low.onnx.gz
# PIPER_UK_VOICE=models/uk_UK-lada-low.onnx.gz

# Audio / VAD parameters
VAD_ENABLED=true
VAD_ENERGY_THRESHOLD=300
VAD_SILENCE_DURATION=1.2
VAD_MIN_DURATION=0.5
VAD_MAX_DURATION=12.0

# LLM Configuration
LLM_MAX_TOKENS=150
